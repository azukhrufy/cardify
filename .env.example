# ---------------------------------------------------------------------------
# Cardify — Local credentials & environment
# ---------------------------------------------------------------------------
# File ini DIKOMIT (lihat .gitignore di baris .env*).
# Copy jadi .env dan isi nilai asli. Jangan push .env ke repo.
# ---------------------------------------------------------------------------

# ===========================================================================
# GITHUB — untuk @guntur_dev_bot dan operasi git/gh CLI
# ===========================================================================
# Dibutuhkan kalau agent mau: clone/pull/push repo, buka PR/MR, baca issue.
#
# Opsi A — GitHub CLI token (direkomendasikan untuk gh auth login --with-token):
#   Generate di GitHub Settings → Developer settings → Personal access tokens → Fine-grained
#   atau Tokens (classic). Scopes untuk classic:
#     - repo             : full akses ke repo (push, PR, read issues)
#     - read:org         : kalau butuh akses ke org resources
#   Cukup satu token yang punya scope "repo" kalau repo pribadi.
#
# Opsi B — SSH key (alternate, tidak pakai token di environment):
#   Setup ssh-agent di mesin, tambah key ke GitHub Settings → SSH keys.
#   Gunakan remote URL SSH: git@github.com:azukhrufy/cardify.git
#   Key ini TIDAK perlu dimasukkan ke .env — cukup tersedia di ssh-agent.
# ===========================================================================

# Token GitHub (classic PAT atau fine-grained). Isi kalau pakai opsi A.
# Format: ghp_...  atau  github_pat_...
GITHUB_TOKEN=

# (Opsional) Username GitHub — dipakai gh auth untuk beberapa operasi.
GITHUB_USER=azukhrufy

# ===========================================================================
# NOTION — untuk @ipin_pm_bot dan integrasi Notion API
# ===========================================================================
# Dibutuhkan kalau ada fitur yang connect ke Notion (misal: simpan rate card
# ke Notion database, baca task, dll).
#
# Generate di Notion → Settings & Members → Connections → Add connection
# atau https://www.notion.so/my-integrations
#
# Capabilities yang biasa dibutuhkan:
#   - Read content
#   - Write content
#   - Insert content (kalau mau append ke database/page)
#
# Setelah integraci dibuat, salin Internal Integration Token.
# ===========================================================================

NOTION_API_KEY=

# (Opsional) ID workspace/database Notion — dipakai kalau agent perlu
# tahu database mana yang jadi target (misal: database task/kanban).
# Notion database ID dicari dari URL: https://notion.so/<database-id>
NOTION_DATABASE_ID=

# ===========================================================================
# SOCIAL CONNECT (OAuth) — fitur "Hubungkan Akun" di kalkulator
# ===========================================================================
# Semua nilai di bawah ini SERVER-ONLY (tanpa prefix NEXT_PUBLIC_), jadi tidak
# pernah ikut ter-bundle ke browser. Isi di server/hosting, bukan di repo.
#
# Butuh base URL publik untuk callback OAuth. Di lokal pakai tunnel
# (mis. `ngrok http 3000`) karena platform menolak redirect ke localhost.
# Callback path: {BASE_URL}/api/social/oauth/callback
# ===========================================================================

# ── WAJIB: kunci enkripsi sesi (cookie httpOnly) ──
# Minimal 32 karakter acak. Generate: `openssl rand -base64 48`
# Tanpa ini, seluruh alur OAuth dimatikan dan UI menampilkan pesan konfigurasi.
SOCIAL_SESSION_SECRET=

# ── YouTube / Google Cloud Console ──
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Aktifkan "YouTube Data API v3". Authorized redirect URI:
#   {BASE_URL}/api/social/oauth/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── Instagram / Meta for Developers ──
# developers.facebook.com → App (tipe Business) → Settings → Basic
#   INSTAGRAM_APP_ID     = "ID Aplikasi"
#   INSTAGRAM_APP_SECRET = "Kunci Rahasia Aplikasi"
# Produk "Instagram" harus ditambahkan ke app; akun IG wajib tipe
# Bisnis/Kreator dan tertaut ke Halaman Facebook.
# OAuth redirect URI (Facebook Login → Settings):
#   {BASE_URL}/api/social/oauth/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# (Opsional) override versi Graph API, default v21.0
INSTAGRAM_GRAPH_VERSION=

# ── TikTok for Developers ──
# developers.tiktok.com → app → Login Kit + Display API
# Scope yang dipakai: user.info.basic, user.info.stats, video.list
# Redirect URI: {BASE_URL}/api/social/oauth/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
